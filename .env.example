# RAG 스택(docker-compose.rag.yml)용 환경변수. 복사: cp .env.example .env
# law_agent 의 Groq 답변 생성에 필요 (검색만 하면 없어도 됨)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# arctic 임베딩 모델 캐시 위치(호스트). 기본은 호스트 HF 캐시를 재사용해 재다운로드를 피한다.
# VM 등 캐시가 없으면 이 경로에 최초 1회(~1.2GB) 다운로드되어 이후 재사용된다.
HF_CACHE_DIR=${HOME}/.cache/huggingface
